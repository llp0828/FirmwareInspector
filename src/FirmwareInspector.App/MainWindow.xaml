<Window x:Class="FirmwareInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firmware Inspector"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#ECEEEF"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded">
  <Window.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#ECEEEF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F6F7" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#DFE2E5" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#CBD1D6" />
    <SolidColorBrush x:Key="TextBrush" Color="#24292E" />
    <SolidColorBrush x:Key="TextStrongBrush" Color="#15191D" />
    <SolidColorBrush x:Key="MutedBrush" Color="#68717A" />
    <SolidColorBrush x:Key="FaintBrush" Color="#969DA5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#376AD4" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#2554B2" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF0FD" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#32745B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9A6B32" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B84A43" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F4F6F8" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#E9EDF1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentStrongBrush}" />
    </Style>

    <Style x:Key="StructureList" TargetType="ListBox">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style x:Key="StructureListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1">
              <Grid>
                <Border x:Name="SelectionBar"
                        Width="2"
                        HorizontalAlignment="Left"
                        Background="Transparent" />
                <ContentPresenter Margin="12,7,8,7" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter TargetName="SelectionBar" Property="Background" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FlatFieldList" TargetType="ItemsControl">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="MinHeight" Value="40" />
                  <Setter Property="Background" Value="Transparent" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBitField}" Value="True">
                      <Setter Property="MinHeight" Value="32" />
                      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="188" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="62" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="16,0,12,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                  <Border Width="10"
                          Height="10"
                          Margin="0,0,7,0"
                          VerticalAlignment="Center"
                          BorderBrush="{StaticResource LineStrongBrush}"
                          BorderThickness="1"
                          CornerRadius="1"
                          Visibility="{Binding IsBitField, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding BitValue}" Value="1">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <TextBlock VerticalAlignment="Center"
                             Foreground="{StaticResource MutedBrush}"
                             FontSize="11"
                             Text="{Binding DisplayName}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="0,6,16,6"
                            VerticalAlignment="Center">
                  <TextBlock Foreground="{StaticResource TextStrongBrush}"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="10.5"
                             Text="{Binding Value}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Margin="0,2,0,0"
                             Foreground="{StaticResource FaintBrush}"
                             FontSize="9"
                             Text="{Binding Note}"
                             TextTrimming="CharacterEllipsis"
                             Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource FaintBrush}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="9"
                           Text="{Binding OffsetText}" />
              </Grid>
            </Border>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="0,0,0,1">
                <TabPanel IsItemsHost="True"
                          Margin="16,6,0,6"
                          VerticalAlignment="Stretch" />
              </Border>
              <ContentPresenter Grid.Row="1"
                                ContentSource="SelectedContent"
                                VerticalAlignment="Stretch" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Height" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid>
              <Border x:Name="Root"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="1"
                      CornerRadius="2">
                <ContentPresenter Margin="17,0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  ContentSource="Header" />
              </Border>
              <Border x:Name="Indicator"
                      Height="2"
                      Margin="2,0,2,1"
                      VerticalAlignment="Bottom"
                      Background="Transparent"
                      CornerRadius="1" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter TargetName="Root" Property="Background" Value="#EEF1F3" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Root" Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="InspectorLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <Style x:Key="InspectorValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" Background="#22272C" CornerRadius="3">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="9"
                       FontWeight="SemiBold"
                       Text="FW" />
          </Border>
          <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock Foreground="{StaticResource TextStrongBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Text="Firmware Inspector" />
            <TextBlock Foreground="{StaticResource FaintBrush}"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="7.5"
                       Text="SMBIOS 3.8 STRUCTURE WORKBENCH" />
          </StackPanel>
        </StackPanel>

        <Border Grid.Column="1"
                Width="1"
                Height="22"
                Margin="18,0"
                Background="{StaticResource LineBrush}" />

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <TextBlock Margin="0,0,12,0"
                     Foreground="{StaticResource TextStrongBrush}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Text="SMBIOS 结构" />
          <Border Padding="6,2" Background="{StaticResource AccentSoftBrush}" CornerRadius="2">
            <TextBlock Foreground="{StaticResource AccentStrongBrush}"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="8"
                       Text="{Binding VersionText, StringFormat=SMBIOS {0}}" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="4"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Border Width="280"
                  Height="30"
                  Margin="0,0,8,0"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1"
                  CornerRadius="3">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource FaintBrush}"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         FontSize="11"
                         Text="&#xE721;" />
              <TextBox x:Name="TopSearchBox"
                       Grid.Column="1"
                       Margin="0,0,8,0"
                       VerticalContentAlignment="Center"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="10.5"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Grid.Column="1"
                         Margin="1,0,8,0"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Foreground="{StaticResource FaintBrush}"
                         FontSize="10"
                         Text="筛选类型、名称、字段值或句柄">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=TopSearchBox}" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>

          <Button Style="{StaticResource SecondaryButton}"
                  Margin="0,0,8,0"
                  Command="{Binding ExportJsonCommand}"
                  Content="导出 JSON" />
          <Button Style="{StaticResource PrimaryButton}"
                  Command="{Binding RefreshCommand}"
                  Content="重新读取" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="278" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="238" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="54" />
          <RowDefinition Height="28" />
          <RowDefinition Height="*" />
          <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
          <Grid Margin="14,0">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource LabelText}" Text="STRUCTURE INDEX" />
              <TextBlock Margin="0,2,0,0"
                         Foreground="{StaticResource TextStrongBrush}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Text="结构列表" />
            </StackPanel>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="7,2"
                    Background="{StaticResource AccentSoftBrush}"
                    CornerRadius="2">
              <TextBlock Foreground="{StaticResource AccentStrongBrush}"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="9"
                         Text="{Binding StructureCountText}" />
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="54" />
            <ColumnDefinition Width="36" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center"
                     Foreground="{StaticResource FaintBrush}"
                     FontSize="8.5"
                     Text="TYPE / 名称" />
          <TextBlock Grid.Column="1"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Right"
                     Foreground="{StaticResource FaintBrush}"
                     FontSize="8.5"
                     Text="句柄" />
          <TextBlock Grid.Column="2"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Right"
                     Foreground="{StaticResource FaintBrush}"
                     FontSize="8.5"
                     Text="长度" />
        </Grid>

        <ListBox Grid.Row="2"
                 Style="{StaticResource StructureList}"
                 ItemContainerStyle="{StaticResource StructureListItem}"
                 ItemsSource="{Binding StructureView}"
                 SelectedItem="{Binding SelectedStructure}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Border Width="50"
                        Height="22"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="2">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource MutedBrush}"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="8.5"
                             FontWeight="SemiBold"
                             Text="{Binding TypeNumberLabel}" />
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                  <TextBlock Foreground="{StaticResource TextBrush}"
                             FontSize="10.5"
                             FontWeight="SemiBold"
                             Text="{Binding TypeName}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Margin="0,2,0,0"
                             Foreground="{StaticResource FaintBrush}"
                             FontSize="8.5"
                             Text="{Binding Summary}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedBrush}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="8.5"
                           Text="{Binding HandleText}" />
                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource FaintBrush}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="8.5"
                           Text="{Binding LengthText}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3"
                Padding="14,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0">
          <Grid>
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource FaintBrush}"
                       FontSize="8.5"
                       Text="RSMB · RAW SMBIOS DATA" />
            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="8.5"
                       Text="{Binding TableLengthText}" />
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="1" Background="{StaticResource LineBrush}" />

      <Grid Grid.Column="2" Background="{StaticResource PanelBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="76" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
          <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="#D7E2FA"
                    BorderThickness="1"
                    CornerRadius="3">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource AccentStrongBrush}"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Text="{Binding SelectedTypeLabel}" />
            </Border>
            <StackPanel Grid.Column="1"
                        Margin="12,0,16,0"
                        VerticalAlignment="Center">
              <TextBlock Foreground="{StaticResource FaintBrush}"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="8"
                         Text="{Binding SelectedHandle, StringFormat=SMBIOS STRUCTURE · {0}}" />
              <TextBlock Margin="0,3,0,0"
                         Foreground="{StaticResource TextStrongBrush}"
                         FontSize="17"
                         FontWeight="SemiBold"
                         Text="{Binding SelectedTypeName}" />
              <TextBlock Margin="0,3,0,0"
                         MaxWidth="760"
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="10"
                         Text="{Binding SelectedPrimaryText}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
              <Border Height="28"
                      Margin="0,0,8,0"
                      Padding="8,0"
                      VerticalAlignment="Center"
                      Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1"
                      CornerRadius="2">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="8.5"
                           Text="{Binding SelectedOffset, StringFormat=OFFSET {0}}" />
              </Border>
              <Border Height="28"
                      Margin="0,0,8,0"
                      Padding="8,0"
                      VerticalAlignment="Center"
                      Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="1"
                      CornerRadius="2">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="8.5"
                           Text="{Binding SelectedLength}" />
              </Border>
              <Button Style="{StaticResource SecondaryButton}"
                      Command="{Binding CopySelectedHexCommand}"
                      Content="复制原始字节" />
            </StackPanel>
          </Grid>
        </Border>

        <TabControl Grid.Row="1">
          <TabItem Header="解析字段">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl Style="{StaticResource FlatFieldList}"
                            ItemsSource="{Binding Fields}" />
            </ScrollViewer>
          </TabItem>

          <TabItem Header="原始字节">
            <Grid Background="{StaticResource PanelBrush}">
              <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="{StaticResource SurfaceBrush}"
                      BorderBrush="{StaticResource LineBrush}"
                      BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                  </Grid.ColumnDefinitions>
                  <TextBlock VerticalAlignment="Center" Style="{StaticResource LabelText}" Text="OFFSET" />
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource LabelText}" Text="BYTES 00–07" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource LabelText}" Text="BYTES 08–0F" />
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource LabelText}" Text="ASCII" />
                </Grid>
              </Border>
              <ListBox Grid.Row="1"
                       Background="{StaticResource PanelBrush}"
                       BorderThickness="0"
                       ItemsSource="{Binding HexLines}"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border Background="Transparent" Padding="0,1">
                            <ContentPresenter />
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid MinWidth="620" MinHeight="23" Margin="16,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="205" />
                        <ColumnDefinition Width="205" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center"
                                 Foreground="{StaticResource FaintBrush}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="10"
                                 Text="{Binding OffsetText}" />
                      <TextBlock Grid.Column="1"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextBrush}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="10"
                                 Text="{Binding FirstHalf}" />
                      <TextBlock Grid.Column="2"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextBrush}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="10"
                                 Text="{Binding SecondHalf}" />
                      <TextBlock Grid.Column="3"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource MutedBrush}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="9.5"
                                 Text="{Binding Ascii}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <TabItem Header="字符串集">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Strings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                      <Grid MinHeight="40" Margin="16,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="52" />
                          <ColumnDefinition Width="68" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentStrongBrush}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="10"
                                   Text="{Binding Index}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource FaintBrush}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="9"
                                   Text="{Binding OffsetText}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="10.5"
                                   Text="{Binding Value}"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>

      <Border Grid.Column="3" Background="{StaticResource LineBrush}" />

      <Border Grid.Column="4"
              Background="{StaticResource SurfaceBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Padding="14,16" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Style="{StaticResource InspectorLabel}" Text="RECORD DETAIL" />
                <TextBlock Style="{StaticResource InspectorValue}"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding SelectedTypeName}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="9.5"
                           Text="{Binding SelectedPrimaryText}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Padding="14,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Style="{StaticResource InspectorLabel}" Text="STRUCTURE" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="9.5" Text="Handle" />
                  <TextBlock Grid.Column="1" Style="{StaticResource InspectorValue}" Text="{Binding SelectedHandle}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="9.5" Text="Offset" />
                  <TextBlock Grid.Column="1" Style="{StaticResource InspectorValue}" Text="{Binding SelectedOffset}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="9.5" Text="Length" />
                  <TextBlock Grid.Column="1" Style="{StaticResource InspectorValue}" Text="{Binding SelectedLength}" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="9.5" Text="Parsed fields" />
                  <TextBlock Grid.Column="1" Style="{StaticResource InspectorValue}" Text="{Binding SelectedFieldCount}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Padding="14,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Style="{StaticResource InspectorLabel}" Text="MACHINE" />
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="9" Text="Manufacturer" />
                <TextBlock Margin="0,3,0,9" Style="{StaticResource InspectorValue}" Text="{Binding MachineManufacturer}" />
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="9" Text="Product" />
                <TextBlock Margin="0,3,0,9" Style="{StaticResource InspectorValue}" Text="{Binding MachineProduct}" />
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="9" Text="Firmware" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource InspectorValue}" Text="{Binding BiosVersion}" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource InspectorValue}" Text="{Binding BiosDate}" />
              </StackPanel>
            </Border>

            <Border Padding="14,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Style="{StaticResource InspectorLabel}" Text="DATA SOURCE" />
                <TextBlock Style="{StaticResource InspectorValue}" Text="GetSystemFirmwareTable" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="9"
                           Text="RSMB · 本机直接读取"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="9"
                           Text="{Binding CapturedAtText, StringFormat=Captured {0}}" />
              </StackPanel>
            </Border>

            <Border Padding="14,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
              <StackPanel>
                <TextBlock Style="{StaticResource InspectorLabel}" Text="INTEGRITY" />
                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="9.5" Text="Structure bounds" />
                  <TextBlock Grid.Column="1" Foreground="{StaticResource SuccessBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="8.5" Text="VALID" />
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="9.5" Text="Warnings" />
                  <TextBlock Grid.Column="1"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="8.5"
                             Text="{Binding WarningText}"
                             ToolTip="{Binding WarningDetails}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Margin="14,14">
              <Button Style="{StaticResource SecondaryButton}"
                      Margin="0,0,0,8"
                      Command="{Binding ExportJsonCommand}"
                      Content="导出 JSON 解析结果" />
              <Button Style="{StaticResource SecondaryButton}"
                      Margin="0,0,0,8"
                      Command="{Binding ExportIniCommand}"
                      Content="导出 INI 可读格式" />
              <Button Style="{StaticResource SecondaryButton}"
                      Command="{Binding ExportRawCommand}"
                      Content="导出完整原始数据" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}" />
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="8.5"
                   Text="{Binding StatusText}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource FaintBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="8" Text="{Binding VersionText, StringFormat=SMBIOS {0}}" />
          <TextBlock Margin="12,0,0,0" Foreground="{StaticResource FaintBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="8" Text="{Binding TableLengthText}" />
          <TextBlock Margin="12,0,0,0" Foreground="{StaticResource FaintBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="8" Text="{Binding StructureCountText, StringFormat={}{0} structures}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
